generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrganizationRole {
  OWNER
  ADMIN
  MEMBER
}

enum AccountStatus {
  ACTIVE
  EXPIRED
  DISCONNECTED
}

enum PostStatus {
  DRAFT
  SCHEDULED
  QUEUED
  PUBLISHING
  PUBLISHED
  FAILED
  SKIPPED
}

enum TargetStatus {
  PENDING
  QUEUED
  PUBLISHING
  PUBLISHED
  FAILED
  SKIPPED
}

enum PlanId {
  FREE
  STARTER
  PRO
  BUSINESS
  AGENCY
  ENTERPRISE
}

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  plan      PlanId   @default(FREE)
  timezone  String   @default("UTC")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships    Membership[]
  socialAccounts SocialAccount[]
  posts          Post[]
  postTargets    PostTarget[]
  auditLogs      AuditLog[]
  brandVoice     BrandVoice?

  @@map("organizations")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String
  displayName  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships Membership[]
  posts       Post[]
  auditLogs   AuditLog[]

  @@map("users")
}

model Membership {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  userId         String           @db.Uuid
  role           OrganizationRole @default(MEMBER)
  createdAt      DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("memberships")
}

/// OAuth tokens are stored as ciphertext; the key belongs to the organization (envelope encryption).
model SocialAccount {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @db.Uuid
  platform       String
  externalId     String
  displayName    String
  tokenCipher    Bytes
  tokenIv        Bytes
  scopes         String[]
  expiresAt      DateTime?
  status         AccountStatus @default(ACTIVE)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  targets      PostTarget[]

  @@unique([organizationId, platform, externalId])
  @@index([organizationId, status])
  @@map("social_accounts")
}

model Post {
  id             String     @id @default(uuid()) @db.Uuid
  organizationId String     @db.Uuid
  authorId       String     @db.Uuid
  /// Language -> thread of posts. Stored as JSON to keep the polymorphic content simple.
  variants       Json
  media          Json       @default("[]")
  idempotencyKey String
  status         PostStatus @default(DRAFT)
  scheduledAt    DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  author       User         @relation(fields: [authorId], references: [id])
  targets      PostTarget[]

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, status, scheduledAt])
  @@map("posts")
}

model PostTarget {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  postId         String       @db.Uuid
  accountId      String       @db.Uuid
  lang           String
  status         TargetStatus @default(PENDING)
  attempts       Int          @default(0)
  remoteId       String?
  url            String?
  error          String?
  publishedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  post          Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  socialAccount SocialAccount @relation(fields: [accountId], references: [id])

  /// One publish attempt per account per post — core idempotency guard.
  @@unique([organizationId, postId, accountId])
  @@index([organizationId, status])
  @@map("post_targets")
}

model BrandVoice {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @unique @db.Uuid
  tone           String
  audience       String
  forbiddenWords String[]
  phrases        String[]
  language       String   @default("en")
  preferredLength Int     @default(280)
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("brand_voices")
}

model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  actorId        String?  @db.Uuid
  action         String
  resource       String
  metadata       Json     @default("{}")
  ip             String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@map("audit_logs")
}
