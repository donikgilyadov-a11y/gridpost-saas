# API
PORT=3001
WEB_ORIGIN=http://localhost:3000
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_TTL=24h

# P1: base64 of 32 random bytes; P2 replaces this with KMS/Vault
TOKEN_MASTER_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
# Production: kms with KMS_KEY_ID (AWS credentials from the environment)
KMS_PROVIDER=env
# KMS_KEY_ID=alias/gridpost-tokens

# OAuth 2.0 (Facebook Pages + Instagram Business)
FACEBOOK_APP_ID=your-app-id
FACEBOOK_APP_SECRET=your-app-secret
OAUTH_REDIRECT_URI=http://localhost:3000/api/v1/oauth/callback

# AI provider: openai | ollama | mock
AI_PROVIDER=openai
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:7b
# AI_MOCK_URL=http://127.0.0.1:8790/completion

# Test seams for local mock servers
# TELEGRAM_API=http://127.0.0.1:8787
# FACEBOOK_API=http://127.0.0.1:8788
# INSTAGRAM_API=http://127.0.0.1:8789

# PostgreSQL (runtime role must not be a superuser — RLS relies on this)
DATABASE_URL=postgresql://gridpost:gridpost@localhost:5432/gridpost?schema=public

# Redis / BullMQ
REDIS_URL=redis://localhost:6379

# S3-compatible storage (MinIO in local dev)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=gridpost-media
S3_ACCESS_KEY=gridpost
S3_SECRET_KEY=gridpost-secret
