# API
PORT=3001
WEB_ORIGIN=http://localhost:3000
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_TTL=24h

# PostgreSQL (runtime role must not be a superuser — RLS relies on this)
DATABASE_URL=postgresql://gridpost:gridpost@localhost:5432/gridpost?schema=public

# Redis / BullMQ
REDIS_URL=redis://localhost:6379

# S3-compatible storage (MinIO in local dev)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=gridpost-media
S3_ACCESS_KEY=gridpost
S3_SECRET_KEY=gridpost-secret
